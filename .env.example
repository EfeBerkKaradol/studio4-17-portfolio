# Studio 4.17 — ortam değişkenleri (Vercel > Project > Settings > Environment Variables)
# Gerçek değerleri .env.local dosyasına veya Vercel'e girin; bu dosyaya yazmayın.

# Site
NEXT_PUBLIC_SITE_URL=https://studio4-17-portfolio.vercel.app

# İletişim (boş bırakılan kanal sitede gösterilmez)
NEXT_PUBLIC_WHATSAPP_NUMBER=      # ör. 905xxxxxxxxx (ülke kodu, boşluksuz)
NEXT_PUBLIC_CONTACT_PHONE=        # ör. +90 5xx xxx xx xx (görünen biçim)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_BEHANCE_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# KVKK veri sorumlusu (aydınlatma metni için)
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=

# Teklif formu teslimi — en az biri gerekli, yoksa form "iletilemedi" hatası verir
RESEND_API_KEY=
QUOTE_TO_EMAIL=                   # teklifleri alacak adres(ler), virgülle
QUOTE_FROM_EMAIL=                 # Resend'de doğrulanmış alan adından, ör. "Studio 4.17 <teklif@alanadi.com>"
QUOTE_WEBHOOK_URL=                # isteğe bağlı: Google Sheets Apps Script / Make / Zapier
QUOTE_WEBHOOK_SECRET=
QUOTE_LOCAL_STORE=                # yalnızca yerel test: 1 ise .quotes/ klasörüne yazar (Vercel'de çalışmaz)

# Analitik ve reklam (boşsa hiçbir izleme kodu ve çerez bandı yüklenmez)
NEXT_PUBLIC_GA_ID=                # G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=        # AW-XXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_LABEL_QUOTE=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_WHATSAPP=
NEXT_PUBLIC_META_PIXEL_ID=
